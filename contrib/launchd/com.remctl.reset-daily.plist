<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.remctl.reset-daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/REPLACE/WITH/INSTALLED/remctl</string>
		<string>reset-daily</string>
		<string>--json</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/REPLACE/WITH/HOME/.config/remctl/logs/reset-daily.out.log</string>
	<key>StandardErrorPath</key>
	<string>/REPLACE/WITH/HOME/.config/remctl/logs/reset-daily.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/REPLACE/WITH/INSTALLED/BIN:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
