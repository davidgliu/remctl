{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "remctl": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"$HOME/bin/remctl\" mcp"
      ],
      "env": {
        "REMCTL_PLUGIN": "1",
        "REMCTL_PLUGIN_BUILD": "e6c35ba1e687e65f"
      }
    }
  }
}
